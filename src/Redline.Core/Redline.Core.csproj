<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Redline.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data/**/*.json;Score/*.json;Drivers/*.json;Cpu/*.json" LogicalName="Redline.Core.$([System.String]::Copy('%(RelativeDir)').Replace('/', '.').Replace('\', '.'))%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Redline.Core.Tests" />
    <InternalsVisibleTo Include="Redline.Engine.Tests" />
  </ItemGroup>
</Project>
