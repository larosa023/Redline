<Application
    x:Class="Redline.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="RlDisplay">ms-appx:///Assets/Fonts/SpaceGrotesk.ttf#Space Grotesk</FontFamily>
      <FontFamily x:Key="RlText">ms-appx:///Assets/Fonts/Inter.ttf#Inter</FontFamily>
      <CornerRadius x:Key="RlCardRadius">22</CornerRadius>
      <CornerRadius x:Key="RlPillRadius">999</CornerRadius>
    </ResourceDictionary>
  </Application.Resources>
</Application>
