<UserControl
    x:Class="Redline.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Redline.App"
    xmlns:c="using:Redline.App.Controls"
    xmlns:vm="using:Redline.App.ViewModels">
  <StackPanel Spacing="16">
    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="1*" MinWidth="260" />
      </Grid.ColumnDefinitions>

      <!-- Status card with tachometer -->
      <Border Background="{StaticResource RlSurface}" BorderBrush="{StaticResource RlLine}" BorderThickness="1" CornerRadius="28" Padding="28,24">
        <Grid ColumnSpacing="28">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid>
            <c:Tachometer x:Name="Tach" />
            <TextBlock Text="MHZ" FontFamily="{StaticResource RlDisplay}" FontSize="13" CharacterSpacing="80" Foreground="{StaticResource RlMuted}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
          </Grid>
          <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
            <ItemsControl ItemsSource="{x:Bind Vm.Home.Chips}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Background="{StaticResource RlGoodBg}" CornerRadius="999" Padding="12,6">
                    <TextBlock Text="{x:Bind}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RlGood}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock FontFamily="{StaticResource RlDisplay}" FontWeight="Bold" FontSize="44" Foreground="{StaticResource RlText}">
              <Run Text="{x:Bind local:Fmt.Mhz(Vm.Home.CoreClockMhz), Mode=OneWay}" /><Run Text=" MHz" FontSize="22" FontWeight="Medium" Foreground="{StaticResource RlMuted}" />
            </TextBlock>
            <TextBlock Text="{x:Bind Vm.Home.Headline, Mode=OneWay}" FontSize="15" Foreground="{StaticResource RlMuted}" TextWrapping="Wrap" MaxWidth="440" HorizontalAlignment="Left" />
            <TextBlock Text="{x:Bind Vm.Home.GpuName, Mode=OneWay}" FontSize="13" Foreground="{StaticResource RlMuted}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- This week -->
      <Border Grid.Column="1" Background="{StaticResource RlSurface}" BorderBrush="{StaticResource RlLine}" BorderThickness="1" CornerRadius="28" Padding="24">
        <StackPanel Spacing="12">
          <TextBlock Text="This week" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource RlText}" />
          <Grid ColumnSpacing="8" RowSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
            <TextBlock Text="Game time" Foreground="{StaticResource RlMuted}" />
            <TextBlock Grid.Column="1" Text="{x:Bind local:Fmt.Hours(Vm.Home.Weekly.GameTime), Mode=OneWay}" FontFamily="{StaticResource RlDisplay}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource RlText}" />
            <TextBlock Grid.Row="1" Text="Energy saved" Foreground="{StaticResource RlMuted}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind local:Fmt.Kwh(Vm.Home.Weekly.EnergySavedKwh), Mode=OneWay}" FontFamily="{StaticResource RlDisplay}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource RlText}" />
            <TextBlock Grid.Row="2" Text="≈ money saved" Foreground="{StaticResource RlMuted}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind local:Fmt.Money(Vm.Home.Weekly.MoneySaved, Vm.Home.CurrencySymbol), Mode=OneWay}" FontFamily="{StaticResource RlDisplay}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource RlText}" />
            <TextBlock Grid.Row="3" Text="Crashes" Foreground="{StaticResource RlMuted}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind local:Fmt.Int(Vm.Home.Weekly.Crashes), Mode=OneWay}" FontFamily="{StaticResource RlDisplay}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource RlGood}" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Live stats -->
    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Border Background="{StaticResource RlSurface}" BorderBrush="{StaticResource RlLine}" BorderThickness="1" CornerRadius="22" Padding="20">
        <StackPanel Spacing="4">
          <TextBlock Text="GPU temp" FontSize="13" Foreground="{StaticResource RlMuted}" />
          <TextBlock Text="{x:Bind local:Fmt.Deg(Vm.Home.TempC), Mode=OneWay}" FontFamily="{StaticResource RlDisplay}" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource RlText}" />
          <c:Sparkline x:Name="TempLine" Stroke="{StaticResource RlGood}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource RlSurface}" BorderBrush="{StaticResource RlLine}" BorderThickness="1" CornerRadius="22" Padding="20">
        <StackPanel Spacing="4">
          <TextBlock Text="Power" FontSize="13" Foreground="{StaticResource RlMuted}" />
          <TextBlock Text="{x:Bind local:Fmt.Watts(Vm.Home.PowerW), Mode=OneWay}" FontFamily="{StaticResource RlDisplay}" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource RlText}" />
          <c:Sparkline x:Name="PowerLine" Stroke="{StaticResource RlAccent}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource RlSurface}" BorderBrush="{StaticResource RlLine}" BorderThickness="1" CornerRadius="22" Padding="20">
        <StackPanel Spacing="4">
          <TextBlock Text="Fans" FontSize="13" Foreground="{StaticResource RlMuted}" />
          <TextBlock Text="{x:Bind local:Fmt.Pct(Vm.Home.FanPct), Mode=OneWay}" FontFamily="{StaticResource RlDisplay}" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource RlText}" />
          <TextBlock Text="{x:Bind local:Fmt.Busy(Vm.Home.UsagePct), Mode=OneWay}" FontSize="13" Foreground="{StaticResource RlMuted}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Background="{StaticResource RlSurface}" BorderBrush="{StaticResource RlLine}" BorderThickness="1" CornerRadius="22" Padding="20">
        <StackPanel Spacing="4">
          <TextBlock Text="{x:Bind Vm.Home.CpuName, Mode=OneWay}" FontSize="13" Foreground="{StaticResource RlMuted}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{x:Bind local:Fmt.DegN(Vm.Home.CpuTempC), Mode=OneWay}" FontFamily="{StaticResource RlDisplay}" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource RlText}" />
          <TextBlock FontSize="13" Foreground="{StaticResource RlMuted}">
            <Run Text="{x:Bind local:Fmt.PctN(Vm.Home.CpuUsagePct), Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind local:Fmt.Ghz(Vm.Home.CpuClockMhz), Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Profiles -->
    <TextBlock Text="Profiles" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource RlText}" />
    <ItemsControl ItemsSource="{x:Bind Vm.Home.Profiles}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="280" ItemHeight="96" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ProfileItemViewModel">
          <Button Command="{x:Bind ApplyCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,12,12" Padding="18"
                  CornerRadius="20" Background="{StaticResource RlSurface}" BorderBrush="{StaticResource RlLine}" BorderThickness="2" AutomationProperties.Name="{x:Bind Name}">
            <StackPanel Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource RlText}" />
                <Border Visibility="{x:Bind IsActive}" Background="{StaticResource RlAccent}" CornerRadius="999" Padding="8,2">
                  <TextBlock Text="On" FontSize="11" FontWeight="Bold" Foreground="{StaticResource RlOnAccent}" />
                </Border>
              </StackPanel>
              <TextBlock Text="{x:Bind Subtitle}" FontSize="13" Foreground="{StaticResource RlMuted}" TextWrapping="Wrap" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
