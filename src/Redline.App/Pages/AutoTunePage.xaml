<UserControl
    x:Class="Redline.App.Pages.AutoTunePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Redline.App"
    xmlns:vm="using:Redline.App.ViewModels">
  <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
    <TextBlock Text="Auto-tune" FontFamily="{StaticResource RlDisplay}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource RlText}" />
    <TextBlock Text="Redline raises or lowers settings a little at a time and checks every step for errors. If anything goes wrong, it steps back. You can keep using your PC, but skip games until it's done."
               Foreground="{StaticResource RlMuted}" TextWrapping="Wrap" FontSize="14" />
    <Border Background="{StaticResource RlSurface}" BorderBrush="{StaticResource RlLine}" BorderThickness="1" CornerRadius="22" Padding="24">
      <StackPanel Spacing="16">
        <RadioButtons x:Name="ModePicker" Header="What do you want?" SelectionChanged="OnModeChanged">
          <x:String>Performance: the highest stable clocks (saved to Send it)</x:String>
          <x:String>Efficiency: same speed, less heat, noise and power (saved to Whisper)</x:String>
        </RadioButtons>
        <CheckBox Content="Memory only: keep my current core clock and find the fastest memory setting (about 20–30 min)"
                  IsChecked="{x:Bind Vm.AutoTune.MemoryOnly, Mode=TwoWay}"
                  Visibility="{x:Bind Vm.AutoTune.MemoryOnlyAvailable, Mode=OneWay}" />
        <CheckBox Content="Allow raising the power limit above 100%" IsChecked="{x:Bind Vm.AutoTune.AllowPowerAbove100, Mode=TwoWay}"
                  Visibility="{x:Bind Vm.AutoTune.PowerOptInAvailable, Mode=OneWay}" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Find my best tune" Command="{x:Bind Vm.AutoTune.StartCommand}" MinHeight="44" Padding="22,10" CornerRadius="14"
                  Background="{StaticResource RlAccent}" Foreground="{StaticResource RlOnAccent}" FontWeight="Bold" />
          <Button Content="Stop and keep last good" Command="{x:Bind Vm.AutoTune.CancelCommand}" MinHeight="44" Padding="18,10" CornerRadius="14" />
        </StackPanel>
        <StackPanel Spacing="6" Visibility="{x:Bind Vm.AutoTune.Running, Mode=OneWay}">
          <ProgressBar Value="{x:Bind local:Fmt.Progress(Vm.AutoTune.Fraction), Mode=OneWay}" Maximum="100" Foreground="{StaticResource RlAccent}" />
          <TextBlock Foreground="{StaticResource RlText}"><Run Text="{x:Bind Vm.AutoTune.CurrentLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind Vm.AutoTune.Remaining, Mode=OneWay}" Foreground="{StaticResource RlMuted}" /></TextBlock>
        </StackPanel>
        <TextBlock Text="{x:Bind Vm.AutoTune.ResultText, Mode=OneWay}" Foreground="{StaticResource RlText}" FontSize="15" TextWrapping="Wrap" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{x:Bind Vm.AutoTune.Steps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StepItem">
              <Border Background="{StaticResource RlSurface2}" CornerRadius="12" Padding="14,10" Margin="0,0,0,4">
                <Grid>
                  <TextBlock Text="{x:Bind Label}" Foreground="{StaticResource RlText}" />
                  <TextBlock Text="{x:Bind Detail}" HorizontalAlignment="Right" Foreground="{StaticResource RlMuted}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
