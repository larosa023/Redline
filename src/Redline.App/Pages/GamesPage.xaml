<UserControl
    x:Class="Redline.App.Pages.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Redline.App.ViewModels">
  <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
    <TextBlock Text="Games" FontFamily="{StaticResource RlDisplay}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource RlText}" />
    <TextBlock Text="When one of these games starts, its profile switches on by itself. When you close the game, your usual profile comes back."
               Foreground="{StaticResource RlMuted}" TextWrapping="Wrap" FontSize="14" />
    <Border Background="{StaticResource RlSurface}" BorderBrush="{StaticResource RlLine}" BorderThickness="1" CornerRadius="22" Padding="24">
      <StackPanel Spacing="12">
        <ComboBox x:Name="Running" Header="Pick a running game" PlaceholderText="Choose from apps that are open" MinWidth="320" SelectionChanged="OnRunningPicked" DropDownOpened="OnRunningOpened" />
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBox Header="…or type its .exe name" PlaceholderText="Cyberpunk2077.exe" Text="{x:Bind Vm.Games.NewExe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <ComboBox x:Name="ProfilePick" Grid.Column="1" Header="Use profile" HorizontalAlignment="Stretch" SelectionChanged="OnProfilePicked" DisplayMemberPath="Name" />
          <Button Grid.Column="2" Content="Add" Command="{x:Bind Vm.Games.AddCommand}" VerticalAlignment="Bottom" MinHeight="36" Padding="20,6" CornerRadius="12"
                  Background="{StaticResource RlAccent}" Foreground="{StaticResource RlOnAccent}" FontWeight="Bold" />
        </Grid>
      </StackPanel>
    </Border>
    <ItemsControl ItemsSource="{x:Bind Vm.Games.Rules}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:GameRuleItem">
          <Border Background="{StaticResource RlSurface}" BorderBrush="{StaticResource RlLine}" BorderThickness="1" CornerRadius="16" Padding="16,10" Margin="0,0,0,8">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind ExeName}" VerticalAlignment="Center" Foreground="{StaticResource RlText}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{x:Bind ProfileName}" VerticalAlignment="Center" Foreground="{StaticResource RlMuted}" />
              <Button Grid.Column="2" Content="Remove" Command="{x:Bind RemoveCommand}" CornerRadius="10" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
