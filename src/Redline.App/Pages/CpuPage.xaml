<UserControl
    x:Class="Redline.App.Pages.CpuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
    <TextBlock Text="CPU" FontFamily="{StaticResource RlDisplay}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource RlText}" />
    <TextBlock Text="{x:Bind Vm.Cpu.CpuName, Mode=OneWay}" Foreground="{StaticResource RlMuted}" />
    <Border Background="{StaticResource RlSurface}" BorderBrush="{StaticResource RlLine}" BorderThickness="1" CornerRadius="22" Padding="24">
      <StackPanel Spacing="14">
        <TextBlock Text="Boost per profile" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource RlText}" />
        <TextBlock Text="Uses Windows' own power settings. No drivers, and switching to Factory puts your original Windows settings back."
                   Foreground="{StaticResource RlMuted}" TextWrapping="Wrap" />
        <ComboBox x:Name="ProfilePick" Header="Profile" MinWidth="260" DisplayMemberPath="Name" SelectionChanged="OnProfile" />
        <ComboBox x:Name="BoostPick" Header="CPU boost" MinWidth="320" SelectionChanged="OnBoost" />
        <Slider x:Name="MaxState" Header="Maximum CPU speed (%)" Minimum="50" Maximum="100" StepFrequency="1" ValueChanged="OnMax" />
        <Button Content="Save to profile" Command="{x:Bind Vm.Cpu.SaveCommand}" MinHeight="40" Padding="20,8" CornerRadius="12"
                Background="{StaticResource RlAccent}" Foreground="{StaticResource RlOnAccent}" FontWeight="Bold" />
      </StackPanel>
    </Border>
    <Border Background="{StaticResource RlSurface}" BorderBrush="{StaticResource RlLine}" BorderThickness="1" CornerRadius="22" Padding="24">
      <StackPanel x:Name="Guide" Spacing="10" />
    </Border>
  </StackPanel>
</UserControl>
