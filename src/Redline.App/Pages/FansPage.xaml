<UserControl
    x:Class="Redline.App.Pages.FansPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Redline.App"
    xmlns:c="using:Redline.App.Controls">
  <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
    <TextBlock Text="Fans" FontFamily="{StaticResource RlDisplay}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource RlText}" />
    <InfoBar Severity="Informational" IsOpen="True" IsClosable="False" Title="Fan control isn't available"
             Message="This card's driver doesn't let apps control its fans." Visibility="{x:Bind local:Fmt.NotVis(Vm.Fans.CanControl), Mode=OneWay}" />
    <Border Background="{StaticResource RlSurface}" BorderBrush="{StaticResource RlLine}" BorderThickness="1" CornerRadius="22" Padding="24"
            Visibility="{x:Bind Vm.Fans.CanControl, Mode=OneWay}">
      <StackPanel Spacing="14">
        <ToggleSwitch Header="Use my own fan curve" OnContent="Custom curve" OffContent="Automatic (card default)" IsOn="{x:Bind Vm.Fans.UseCustomCurve, Mode=TwoWay}" />
        <c:FanCurveEditor x:Name="Editor" />
        <ItemsControl ItemsSource="{x:Bind Vm.Fans.Errors}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String"><TextBlock Text="{x:Bind}" Foreground="{StaticResource RlAccent}" TextWrapping="Wrap" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Add point" Command="{x:Bind Vm.Fans.AddPointCommand}" MinHeight="40" CornerRadius="12" />
          <Button Content="Remove point" Command="{x:Bind Vm.Fans.RemovePointCommand}" MinHeight="40" CornerRadius="12" />
          <Button Content="Reset curve" Command="{x:Bind Vm.Fans.ResetCommand}" MinHeight="40" CornerRadius="12" />
          <Button Content="Apply" Command="{x:Bind Vm.Fans.ApplyCommand}" MinHeight="40" Padding="22,8" CornerRadius="12"
                  Background="{StaticResource RlAccent}" Foreground="{StaticResource RlOnAccent}" FontWeight="Bold" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
