<UserControl
    x:Class="Redline.App.Pages.TunePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Redline.App"
    xmlns:vm="using:Redline.App.ViewModels">
  <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
    <TextBlock Text="Tune" FontFamily="{StaticResource RlDisplay}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource RlText}" />
    <InfoBar Severity="Warning" IsOpen="True" IsClosable="False" Title="Intel's overclocking terms"
             Message="Intel asks you to accept that overclocking may shorten your card's life and isn't covered by its warranty. Redline still keeps every change inside safe limits, with keep-or-revert."
             Visibility="{x:Bind Vm.Tune.NeedsWaiver, Mode=OneWay}">
      <InfoBar.ActionButton><Button Content="I accept" Command="{x:Bind Vm.Tune.AcceptWaiverCommand}" /></InfoBar.ActionButton>
    </InfoBar>
    <InfoBar Severity="Informational" IsOpen="True" IsClosable="False" Message="{x:Bind Vm.Tune.VendorNote, Mode=OneWay}"
             Visibility="{x:Bind local:Fmt.VisText(Vm.Tune.VendorNote), Mode=OneWay}" />
    <TextBlock Text="Move the sliders, then press Apply. Nothing changes on your card until you do, and changes undo themselves after 15 seconds unless you keep them."
               Foreground="{StaticResource RlMuted}" TextWrapping="Wrap" FontSize="14" />

    <InfoBar Severity="Informational" IsOpen="True" IsClosable="False" Title="This graphics card can't be tuned"
             Message="Its driver doesn't allow tuning (common on laptops). Monitoring still works."
             Visibility="{x:Bind local:Fmt.NotVis(Vm.Tune.CanTune), Mode=OneWay}" />

    <Border Background="{StaticResource RlSurface}" BorderBrush="{StaticResource RlLine}" BorderThickness="1" CornerRadius="22" Padding="24"
            Visibility="{x:Bind Vm.Tune.CanTune, Mode=OneWay}">
      <StackPanel Spacing="18">
        <ItemsControl ItemsSource="{x:Bind Vm.Tune.Sliders}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SliderViewModel">
              <Grid Margin="0,0,0,14" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" Foreground="{StaticResource RlText}" FontWeight="SemiBold" />
                <Slider Grid.Column="1" Minimum="{x:Bind MinD, Mode=OneWay}" Maximum="{x:Bind MaxD, Mode=OneWay}" StepFrequency="{x:Bind StepD, Mode=OneWay}"
                        Value="{x:Bind ValueD, Mode=TwoWay}" Foreground="{StaticResource RlAccent}" AutomationProperties.Name="{x:Bind Label}" />
                <TextBlock Grid.Column="2" Text="{x:Bind Display, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontFamily="{StaticResource RlDisplay}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource RlText}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <InfoBar Severity="Warning" IsOpen="True" IsClosable="False" Title="About your card's power connector"
                 Message="Your card uses the 16-pin power connector. Raising the power limit above 100% sends more current through it. Make sure the plug is pushed in fully and the cable isn't bent sharply near the connector."
                 Visibility="{x:Bind Vm.Tune.NeedsConnectorWarning, Mode=OneWay}">
          <InfoBar.ActionButton>
            <Button Content="I've checked it" Command="{x:Bind Vm.Tune.AcknowledgeConnectorCommand}" />
          </InfoBar.ActionButton>
        </InfoBar>

        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="{x:Bind Vm.Tune.ApplySummary, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource RlMuted}" TextWrapping="Wrap" />
          <Button Grid.Column="1" Content="Discard" Command="{x:Bind Vm.Tune.DiscardCommand}" MinHeight="44" Padding="18,10" CornerRadius="14" />
          <Button Grid.Column="2" Content="Apply" Command="{x:Bind Vm.Tune.ApplyCommand}" MinHeight="44" Padding="24,10" CornerRadius="14"
                  Background="{StaticResource RlAccent}" Foreground="{StaticResource RlOnAccent}" FontWeight="Bold" />
        </Grid>
      </StackPanel>
    </Border>

    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Button Content="Back to factory" Command="{x:Bind Vm.Tune.ResetCommand}" MinHeight="44" Padding="18,10" CornerRadius="14" />
      <Button Grid.Column="1" Content="Undo last change" Command="{x:Bind Vm.Tune.UndoCommand}" MinHeight="44" Padding="18,10" CornerRadius="14" />
      <ToggleSwitch Grid.Column="2" HorizontalAlignment="Right" Header="Advanced (full driver range)" IsOn="{x:Bind Vm.Tune.AdvancedEnabled, Mode=TwoWay}" />
    </Grid>
  </StackPanel>
</UserControl>
