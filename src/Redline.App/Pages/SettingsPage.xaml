<UserControl
    x:Class="Redline.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel x:Name="Body" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
    <TextBlock Text="Settings" FontFamily="{StaticResource RlDisplay}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource RlText}" />
    <Border Background="{StaticResource RlSurface}" BorderBrush="{StaticResource RlLine}" BorderThickness="1" CornerRadius="22" Padding="24">
      <StackPanel Spacing="18">
        <Slider x:Name="Ceiling" Header="Temperature limit (°C) — Redline eases off your tune above this" Minimum="70" Maximum="90" StepFrequency="1" ValueChanged="OnCeiling" />
        <ToggleSwitch x:Name="PowerOptIn" Header="Allow power limit above 100%" Toggled="OnPowerOptIn" />
        <NumberBox x:Name="Rate" Header="Electricity price per kWh" Minimum="0" Maximum="5" SmallChange="0.01" SpinButtonPlacementMode="Inline" ValueChanged="OnRate" />
        <ToggleSwitch x:Name="Overlay" Header="In-game overlay (FPS, 1% lows, temperatures)" Toggled="OnOverlay" />
        <ComboBox x:Name="Corner" Header="Overlay position" SelectionChanged="OnCorner" MinWidth="200">
          <x:String>TopLeft</x:String><x:String>TopRight</x:String><x:String>BottomLeft</x:String><x:String>BottomRight</x:String>
        </ComboBox>
        <TextBlock Text="The overlay shows over borderless and windowed games. Some exclusive-fullscreen games hide it. It never touches the game itself, so it's safe with anti-cheat."
                   Foreground="{StaticResource RlMuted}" TextWrapping="Wrap" FontSize="13" />
        <TextBlock Text="Redline sends nothing about you anywhere. The only thing it checks online is whether there's an update."
                   Foreground="{StaticResource RlMuted}" TextWrapping="Wrap" />
        <TextBlock x:Name="Version" Foreground="{StaticResource RlMuted}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
