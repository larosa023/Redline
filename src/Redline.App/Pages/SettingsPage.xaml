<UserControl
    x:Class="Redline.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel x:Name="Body" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
    <TextBlock Text="Settings" FontFamily="{StaticResource RlDisplay}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource RlText}" />
    <Border Background="{StaticResource RlSurface}" BorderBrush="{StaticResource RlLine}" BorderThickness="1" CornerRadius="22" Padding="24">
      <StackPanel Spacing="18">
        <StackPanel Spacing="8">
          <ToggleSwitch x:Name="StartWithWindows" Header="Put a profile back on when Windows starts" Toggled="OnStartWithWindows" />
          <ComboBox x:Name="StartupProfile" Header="Profile to use" MinWidth="220" PlaceholderText="Run auto-tune first" SelectionChanged="OnStartupProfile" />
          <TextBlock Text="After a restart your card is always at factory settings first. With this on, Redline puts the chosen profile back about 15 seconds after Windows starts. Only profiles that passed auto-tune's full check can be used."
                     Foreground="{StaticResource RlMuted}" TextWrapping="Wrap" FontSize="13" />
        </StackPanel>
        <Slider x:Name="Ceiling" Header="Temperature limit" Minimum="70" Maximum="90" StepFrequency="1" ValueChanged="OnCeiling" />
        <ToggleSwitch x:Name="PowerOptIn" Header="Allow power limit above 100%" Toggled="OnPowerOptIn" />
        <NumberBox x:Name="Rate" Header="Electricity price per kWh (for the money-saved estimate)" Minimum="0" Maximum="5" SmallChange="0.01" SpinButtonPlacementMode="Inline" ValueChanged="OnRate" />
        <ToggleSwitch x:Name="Overlay" Header="In-game overlay (FPS, 1% lows, temperatures)" Toggled="OnOverlay" />
        <ComboBox x:Name="Corner" Header="Overlay position" SelectionChanged="OnCorner" MinWidth="200">
          <ComboBoxItem Content="Top left" Tag="TopLeft" /><ComboBoxItem Content="Top right" Tag="TopRight" />
          <ComboBoxItem Content="Bottom left" Tag="BottomLeft" /><ComboBoxItem Content="Bottom right" Tag="BottomRight" />
        </ComboBox>
        <TextBlock Text="The overlay shows over borderless and windowed games. Some exclusive-fullscreen games hide it. It never touches the game itself, so it's safe with anti-cheat."
                   Foreground="{StaticResource RlMuted}" TextWrapping="Wrap" FontSize="13" />
        <StackPanel Spacing="8">
          <TextBlock Text="Profile shortcuts" Foreground="{StaticResource RlText}" FontWeight="SemiBold" />
          <TextBlock Text="Click a profile's button, then press a shortcut like Ctrl+Alt+1. Works even in games. Esc cancels."
                     Foreground="{StaticResource RlMuted}" TextWrapping="Wrap" FontSize="13" />
          <StackPanel x:Name="Shortcuts" Spacing="8" />
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBlock Text="Something not working?" Foreground="{StaticResource RlText}" FontWeight="SemiBold" />
          <TextBlock Text="Create a report saves a zip to your Downloads folder with your hardware summary, Redline's settings and recent logs. Your user name and PC name are removed. It's only shared if you attach it somewhere yourself."
                     Foreground="{StaticResource RlMuted}" TextWrapping="Wrap" FontSize="13" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="ReportButton" Content="Create report" Click="OnReport" />
            <TextBlock x:Name="ReportMessage" Foreground="{StaticResource RlMuted}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="560" />
          </StackPanel>
        </StackPanel>
        <TextBlock Text="Redline sends nothing about you anywhere. The only thing it checks online is whether there's an update."
                   Foreground="{StaticResource RlMuted}" TextWrapping="Wrap" />
        <TextBlock x:Name="Version" Foreground="{StaticResource RlMuted}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
